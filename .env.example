# 大模型（二选一，均为国产优先）
LLM_PROVIDER=qwen
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# 统一端点与模型名（注意：真实密钥只写在 .env，不要提交）
AI_BASE_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-flash

# 本地降级通道：LLM 不可用时启用模板 + 规则编排
LLM_FALLBACK_ENABLED=true

# 服务
API_PORT=8000
LOG_LEVEL=INFO

# 登录（多用户演示）：不设 = off（单用户 u_demo）；设 demo 才出登录页与退出登录。
# 设为 demo 时必须同时给口令，否则现场登录不了（未配置时回落到内置演示口令）。
AIB_AUTH_MODE=
AIB_DEMO_PASSWORD=

# 飞书渠道（企业自建应用）。四项齐全且未启用 replay 时 /api/channels/health 显示 adapter/已配置；
# 留空即如实显示 replay / 未配置。真实值只写本地 .env，不要提交。
# 不要设 AIB_FEISHU_REPLAY_MODE=true——那会让生产凭据被忽略。见 docs/2026-10-27/飞书接入-配置单.md。
AIB_FEISHU_APP_ID=
AIB_FEISHU_APP_SECRET=
AIB_FEISHU_VERIFICATION_TOKEN=
AIB_FEISHU_ENCRYPT_KEY=
